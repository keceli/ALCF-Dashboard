# ===========================================================================
# PBS wrapper that runs auto_update.sh on a compute node (proxy for pip + PVC
# GPU for verify). Submitted by trigger_auto_update.sh. Env knobs (TRACK_MODE,
# ON_FAIL, FORCE, CHEMGRAPH_EXTRAS) pass through via `qsub -v`.
# ===========================================================================
cd /lus/flare/projects/catalyst/world_shared/chemgraph
bash auto_update.sh
echo "auto_update.pbs finished rc=$? at $(date)"
